{
  "name": "wloc-spoofer",
  "main": "src/index.js",
  // 运行时语义快照。这个 Worker 只用 fetch/URL/TextDecoder 等标准 Web API,
  // 不需要 nodejs_compat —— 实测去掉后产物字节数完全一致, 且省掉一份启动开销。
  "compatibility_date": "2026-08-05",
  // 授权版必须绑定 D1。先运行:
  //   npx wrangler d1 create wloc-license-db --binding DB --location apac --update-config
  // 新版 Wrangler 会自动添加绑定；否则取消下面整段注释并填入 database_id。
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "wloc-license-db",
  //     "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
  //     "migrations_dir": "migrations"
  //   }
  // ],
  // ADMIN_TOKEN 必须通过 `npx wrangler secret put ADMIN_TOKEN` 设置，不能写在这里。
  // 关闭持久化日志采集, 与 README 中「/api/parse 不记日志」的说法对齐。
  // 调试仍可用 `wrangler tail`, 那是实时流, 不落盘。
  "observability": { "enabled": false }
}
