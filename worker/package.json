{
  "type": "module",
  "scripts": {
    "test": "node --test 'test/*.test.*'",
    "build:licensed-client": "node scripts/build-licensed-local-client.mjs",
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy --minify",
    "license-admin": "node scripts/license-admin.mjs",
    "db:migrate:local": "npx wrangler d1 migrations apply wloc-license-db --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply wloc-license-db --remote",
    "pages:dev": "npx wrangler pages dev --port 8787 -c wrangler.pages.jsonc",
    "pages:deploy": "npx wrangler pages deploy -c wrangler.pages.jsonc"
  },
  "dependencies": {
    "hono": "^4.10.6"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
