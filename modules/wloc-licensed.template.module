#!name=Apple WLOC 授权版（模板）
#!desc=请勿直接安装此模板；部署 Worker 后通过管理员接口生成每个用户的专属模块地址
#!author=Quin9
#!homepage=https://github.com/Quin9/wloc1
#!icon=https://raw.githubusercontent.com/Quin9/wloc1/refs/heads/main/wloc.jpg
#!category=Tools

[Script]
Apple WLOC Licensed = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=2097152,timeout=30,script-path=https://raw.githubusercontent.com/Quin9/wloc1/refs/heads/main/client/wloc-remote.js,argument=apiBase=https://wloc-spoofer.shenguanjige.workers.dev&licenseKey=请通过管理接口生成&accuracy=25&randomRadius=0&logLevel=info
WLOC Settings = type=http-request,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save,requires-body=0,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/Quin9/wloc1/refs/heads/main/dist/wloc-settings.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
